# Образец окружения. Скопировать в bot/.env и заполнить своими значениями.
# Сам bot/.env в репозиторий не попадает — он в .gitignore.

# --- обязательное ----------------------------------------------------------------
# Токен бота от @BotFather.
BOT_TOKEN=123456789:PUT-YOUR-OWN-TOKEN-HERE

# Кто администратор. По telegram-id — надёжно; свой id бот скажет по /id.
ADMIN_IDS=

# По username — слабее: освободившийся username может занять кто угодно.
# Годится, пока id неизвестен; как человек написал боту — переносите его в ADMIN_IDS.
ADMIN_USERNAMES=

# Публичный контакт для кнопки «написать преподавателю», без собачки.
# Без него кнопки просто не будет — ссылка t.me/ ведёт в никуда.
SUPPORT_USERNAME=

# --- предохранитель ---------------------------------------------------------------
# Пока включён (значение по умолчанию), сообщения посторонним не уходят:
# письмо студенту разворачивается на администратора с пометкой «песочница».
# Выключается ТОЛЬКО здесь и перезапуском — кнопки в интерфейсе нет намеренно.
SAFE_MODE=1

# Чаты, которым в песочнице писать можно помимо администраторов.
SANDBOX_CHAT_IDS=

# --- необязательное ----------------------------------------------------------------
# Где лежат отчёты проверки, если не рядом с проектом.
OUT_DIR=

# Третий сезон: таблица заявок в Notion. Без них анкеты копятся в очереди
# и дойдут, когда переменные появятся.
NOTION_TOKEN=
NOTION_DB=

# GitHub: без токена 60 запросов в час — на поток в двести человек не хватает.
GITHUB_TOKEN=
